{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ]
    },
    "bundle:agent": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{workspaceRoot}/dist"
      ]
    },
    "release:exe": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{workspaceRoot}/release"
      ]
    }
  },
  "analytics": true
}